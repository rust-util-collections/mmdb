{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(docs/audit.md)",
      "Edit(Cargo.toml)",
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo fmt)",
      "Bash(cargo fmt:*)",
      "Bash(cargo metadata:*)",
      "Bash(make)",
      "Bash(make:*)",
      "Bash(git diff:*)",
      "Bash(git diff)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git status)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch)",
      "Bash(git rev-parse:*)"
    ],
    "deny": [
      "Bash(git stash)",
      "Bash(git stash:*)",
      "Bash(git clean)",
      "Bash(git clean:*)",
      "Bash(git checkout --:*)",
      "Bash(git restore:*)",
      "Bash(git add -A)",
      "Bash(git add -A:*)",
      "Bash(git add --all)",
      "Bash(git add --all:*)",
      "Bash(git add -u)",
      "Bash(git add -u:*)",
      "Bash(git add --update)",
      "Bash(git add --update:*)",
      "Bash(git add .)",
      "Bash(git commit --amend)",
      "Bash(git commit --amend:*)",
      "Bash(git commit -a)",
      "Bash(git commit -a:*)",
      "Bash(git commit -am:*)",
      "Bash(git commit --all)",
      "Bash(git commit --all:*)",
      "Bash(git reset)",
      "Bash(git reset:*)",
      "Bash(git rebase)",
      "Bash(git rebase:*)",
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(git branch -D)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d)",
      "Bash(git branch -d:*)",
      "Bash(git branch -f:*)",
      "Bash(git branch --force:*)",
      "Bash(git filter-branch:*)",
      "Bash(git replace:*)"
    ]
  }
}
