diff --git a/src/write_trace.rs b/src/write_trace.rs
new file mode 100644
index 0000000..7b05796
--- /dev/null
+++ b/src/write_trace.rs
@@ -0,0 +1,69 @@
+//! Trace-only instrumentation for the detached writer-stage replay experiment.
+use std::{cell::RefCell, time::Instant};
+
+#[derive(Debug)]
+pub struct Group {
+    pub sequence: u64,
+    pub requests: usize,
+    pub operations: u64,
+    pub generation: u64,
+    pub start: Instant,
+    pub wal_start: Instant,
+    pub wal_end: Instant,
+    pub apply_start: Instant,
+    pub apply_end: Instant,
+    pub release: Option<Instant>,
+}
+
+#[derive(Default)]
+pub struct Trace {
+    pub enqueued: Vec<Instant>,
+    pub groups: Vec<Group>,
+}
+
+thread_local! {
+    static TRACE: RefCell<Option<Trace>> = const { RefCell::new(None) };
+}
+
+pub fn begin(capacity: usize) {
+    TRACE.with_borrow_mut(|trace| {
+        *trace = Some(Trace {
+            enqueued: Vec::with_capacity(capacity),
+            groups: Vec::with_capacity(capacity),
+        })
+    });
+}
+
+pub fn finish() -> Option<Trace> {
+    TRACE.with_borrow_mut(Option::take)
+}
+
+pub(crate) fn stamp() -> Option<Instant> {
+    TRACE.with_borrow(|trace| trace.is_some().then(Instant::now))
+}
+
+pub(crate) fn enqueue() {
+    TRACE.with_borrow_mut(|trace| {
+        if let Some(trace) = trace {
+            trace.enqueued.push(Instant::now());
+        }
+    });
+}
+
+pub(crate) fn record(group: Group) {
+    TRACE.with_borrow_mut(|trace| {
+        if let Some(trace) = trace {
+            trace.groups.push(group);
+        }
+    });
+}
+
+pub(crate) fn release() {
+    TRACE.with_borrow_mut(|trace| {
+        if let Some(group) = trace.as_mut().and_then(|t| t.groups.last_mut())
+            && group.release.is_none()
+        {
+            group.release = Some(Instant::now());
+        }
+    });
+}
