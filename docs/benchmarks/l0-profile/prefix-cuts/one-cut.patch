+    #[test]
+    fn one_prefix_cut_preserves_stripes_and_crossing_range_deletion() {
+        fn key(head: u8, n: u32) -> [u8; 12] {
+            let mut key = [head; 12];
+            key[8..].copy_from_slice(&n.to_be_bytes());
+            key
+        }
+        let tmp = tempfile::tempdir().unwrap();
+        let options = DbOptions::default()
+            .with_num_levels(2)
+            .with_prefix_len(8)
+            .with_l0_compaction_trigger(usize::MAX);
+        let db = DB::open(options.clone(), tmp.path()).unwrap();
+        for head in [b'a', b'm', b'z'] {
+            for id in 0..256 {
+                db.put(&key(head, id), &[head; 256]).unwrap();
+            }
+        }
+        let initial = db.snapshot();
+        let lo = key(b'a', 128);
+        let hi = key(b'z', 64);
+        db.delete_range(&lo, &hi).unwrap();
+        let deleted = db.snapshot();
+        let boundary = key(b'm', 0);
+        db.put(&boundary, b"new").unwrap();
+        db.flush().unwrap();
+        let current = db.snapshot();
+
+        let check = |view: &Snapshot<'_>, phase: u8| {
+            let mut expected = Vec::new();
+            for head in [b'a', b'm', b'z'] {
+                for id in 0..256 {
+                    let k = key(head, id);
+                    let value = if phase == 2 && k == boundary {
+                        Some(b"new".to_vec())
+                    } else if phase == 0 || k < lo || k >= hi {
+                        Some(vec![head; 256])
+                    } else {
+                        None
+                    };
+                    assert_eq!(view.get(&k).unwrap(), value);
+                    if let Some(value) = value {
+                        expected.push((k.to_vec(), value));
+                    }
+                }
+            }
+            let mut iter = view.iter().unwrap();
+            assert_eq!(iter.by_ref().collect::<Vec<_>>(), expected);
+            assert!(iter.error().is_none());
+        };
+        assert_eq!(db.get_property("num-files-at-level0").as_deref(), Some("2"));
+        {
+            let inner = db.inner.lock();
+            let version = inner.versions.current();
+            for file in version.level_files(0) {
+                assert!(file.meta.file_size >= 32 << 10);
+            }
+        }
+        check(&initial, 0);
+        check(&deleted, 1);
+        check(&current, 2);
+        db.compact().unwrap();
+        check(&initial, 0);
+        check(&deleted, 1);
+        check(&current, 2);
+        drop((initial, deleted, current));
+        db.close().unwrap();
+        let db = DB::open(options, tmp.path()).unwrap();
+        check(&db.snapshot(), 2);
+
+        // One large prefix followed by a short tail must stay in one file.
+        for id in 0..256 {
+            db.put(&key(b'a', id), &[1; 256]).unwrap();
+        }
+        db.put(&key(b'z', 0), b"tail").unwrap();
+        db.flush().unwrap();
+        assert_eq!(db.get_property("num-files-at-level0").as_deref(), Some("1"));
+    }
