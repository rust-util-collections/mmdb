+    #[test]
+    fn full_l0_claim_selects_the_same_cold_gap_after_disjoint_flushes() {
+        for separate_flushes in [false, true] {
+            let tmp = tempfile::tempdir().unwrap();
+            let options = DbOptions::default()
+                .with_num_levels(2)
+                .with_prefix_len(8)
+                .with_l0_compaction_trigger(usize::MAX);
+            let db = DB::open(options, tmp.path()).unwrap();
+            db.ingest_sorted([(b"cccccccc/cold".as_slice(), b"middle".as_slice())])
+                .unwrap();
+            db.put(b"aaaaaaaa/low", b"left").unwrap();
+            if separate_flushes {
+                db.flush().unwrap();
+            }
+            db.put(b"zzzzzzzz/high", b"right").unwrap();
+            db.flush().unwrap();
+            let inner = db.inner.lock();
+            let version = inner.versions.current();
+            let task = LeveledCompaction::pick_l0_compaction(&version, &HashSet::new()).unwrap();
+            assert_eq!(
+                task.input_files_level.len(),
+                if separate_flushes { 2 } else { 1 }
+            );
+            assert_eq!(task.input_files_next.len(), 1);
+            assert_eq!(
+                types::user_key(&task.input_files_next[0].meta.smallest_key),
+                b"cccccccc/cold"
+            );
+            if separate_flushes {
+                for file in &task.input_files_level {
+                    let lo = types::user_key(&file.meta.smallest_key);
+                    let hi = types::user_key(&file.meta.largest_key);
+                    assert!(hi < b"cccccccc/cold".as_slice() || lo > b"cccccccc/cold".as_slice());
+                }
+            }
+        }
+    }
