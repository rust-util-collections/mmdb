diff --git a/src/db.rs b/src/db.rs
index 20eb490..75f5183 100644
--- a/src/db.rs
+++ b/src/db.rs
@@ -4815,6 +4815,98 @@ mod tests {
     /// Regression: `drain_l0` looped on the full `pick_compaction`, so once L0
     /// was empty it ran level-size compactions inline — in the stop-trigger
     /// path while holding `write_queue`, stalling every writer.
+    #[test]
+    fn split_l0_preserves_snapshot_stripes_and_concurrent_flush_across_boundaries() {
+        use std::sync::mpsc;
+
+        struct Collector;
+        impl crate::BlockPropertyCollector for Collector {
+            fn add(&mut self, _: &[u8]) {}
+            fn finish_block(&mut self) -> Vec<u8> {
+                Vec::new()
+            }
+            fn name(&self) -> &str {
+                "l0-merge-gate"
+            }
+        }
+
+        for subs in [1, 3] {
+            let dir = tempfile::tempdir().unwrap();
+            let gate = Arc::new(Mutex::new(None::<(mpsc::Sender<()>, mpsc::Receiver<()>)>));
+            let factory_gate = Arc::clone(&gate);
+            let opts = DbOptions::default()
+                .with_num_levels(2)
+                .with_l0_compaction_trigger(usize::MAX)
+                .with_max_subcompactions(subs)
+                .with_block_property_collectors(vec![Arc::new(move || {
+                    let barrier = factory_gate.lock().take();
+                    if let Some((entered, release)) = barrier {
+                        entered.send(()).unwrap();
+                        release.recv_timeout(Duration::from_secs(10)).unwrap();
+                    }
+                    Box::new(Collector)
+                })]);
+            let db = DB::open(opts.clone(), dir.path()).unwrap();
+            // Three separate L1 files with split points at d and k.
+            for pair in [b"ad", b"hk", b"mz"] {
+                db.ingest_sorted(pair.iter().map(|&k| ([k], [0]))).unwrap();
+            }
+            let original = db.snapshot();
+            db.delete_range(b"c", b"y").unwrap();
+            db.flush().unwrap();
+            let wiped = db.snapshot();
+            for k in [b"d", b"k", b"y"] {
+                db.put(k, &[1]).unwrap();
+            }
+            db.flush().unwrap();
+            let replaced = db.snapshot();
+
+            let (entered, picked) = mpsc::channel();
+            let (resume, release) = mpsc::channel();
+            *gate.lock() = Some((entered, release));
+            thread::scope(|threads| {
+                let job = threads.spawn(|| db.drain_l0(true));
+                picked.recv_timeout(Duration::from_secs(10)).unwrap();
+                // A newer L0 file lands while the original inputs are claimed.
+                db.put(b"k", &[2]).unwrap();
+                db.flush().unwrap();
+                resume.send(()).unwrap();
+                job.join().unwrap().unwrap();
+            });
+            #[cfg(feature = "bench-metrics")]
+            {
+                let measured = db.l0_compaction_profile();
+                assert!(measured.multiple_target_jobs > 0);
+                assert_eq!(measured.parallel_jobs > 0, subs > 1);
+                assert_eq!(measured.ranges_executed > measured.rewrite_jobs, subs > 1);
+            }
+
+            fn rows(mut iter: DBIterator) -> Vec<(u8, u8)> {
+                let mut rows = Vec::new();
+                while let Some((k, v)) = iter.step_next().unwrap() {
+                    assert_eq!((k.len(), v.len()), (1, 1));
+                    rows.push((k[0], v[0]));
+                }
+                rows
+            }
+            assert_eq!(rows(original.iter().unwrap()), b"adhkmz".map(|k| (k, 0)));
+            assert_eq!(rows(wiped.iter().unwrap()), [(b'a', 0), (b'z', 0)]);
+            assert_eq!(
+                rows(replaced.iter().unwrap()),
+                [(b'a', 0), (b'd', 1), (b'k', 1), (b'y', 1), (b'z', 0)]
+            );
+            let expected = [(b'a', 0), (b'd', 1), (b'k', 2), (b'y', 1), (b'z', 0)];
+            for (key, value) in expected {
+                assert_eq!(db.get(&[key]).unwrap(), Some(vec![value]));
+            }
+            assert_eq!(rows(db.iter().unwrap()), expected);
+            drop((original, wiped, replaced));
+            db.close().unwrap();
+            let reopened = DB::open(opts, dir.path()).unwrap();
+            assert_eq!(rows(reopened.iter().unwrap()), expected);
+        }
+    }
+
